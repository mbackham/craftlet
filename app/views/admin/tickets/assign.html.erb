<% # Admin view for assigning a ticket handler %>
<div class="panel">
  <h3>指派处理人 — 工单 #<%= @ticket.ticket_no %></h3>
  <div class="panel_contents">
    <p><strong>主题：</strong><%= @ticket.subject %></p>

    <% if @admins.any? %>
      <%= form_tag assign_admin_ticket_path(@ticket), method: :put do %>
        <fieldset class="inputs">
          <ol>
            <li class="select input">
              <label for="assignee_id">选择处理人</label>
              <%= select_tag :assignee_id,
                    options_from_collection_for_select(@admins, :id, :email),
                    prompt: "请选择...",
                    required: true,
                    style: "width: 100%; padding: 8px;" %>
            </li>
          </ol>
        </fieldset>
        <fieldset class="actions">
          <ol>
            <li class="action"><%= submit_tag "确认指派", data: { confirm: "确定指派此工单？" } %></li>
            <li class="cancel"><%= link_to "取消", admin_ticket_path(@ticket) %></li>
          </ol>
        </fieldset>
      <% end %>
    <% else %>
      <p>暂无可用的管理员。</p>
      <p><%= link_to "返回工单", admin_ticket_path(@ticket) %></p>
    <% end %>
  </div>
</div>
